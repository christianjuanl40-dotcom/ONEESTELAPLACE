rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath(request.auth.uid));
    }

    function currentProfile() {
      return get(profilePath(request.auth.uid));
    }

    function hasRole(role) {
      return hasProfile()
        && currentProfile().data.get("role", "") == role
        && currentProfile().data.get("status", "active") != "inactive";
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isStaff() {
      return hasRole("staff");
    }

    function isClient() {
      return hasRole("client");
    }

    function hasPermission(permission) {
      return isAdmin()
        || (isStaff()
          && currentProfile().data.get("permissions", {}).get(permission, false) == true);
    }

    function canReadBookings() {
      return isAdmin() || (isStaff() && (
        hasPermission("dashboard") || hasPermission("bookings") || hasPermission("payments")
      ));
    }

    function canWriteBookings() {
      return isAdmin() || (isStaff() && hasPermission("bookings"));
    }

    function canReadPayments() {
      return isAdmin() || (isStaff() && hasPermission("payments"));
    }

    function canReadReports() {
      return isAdmin() || (isStaff() && hasPermission("reports"));
    }

    function canWritePayments() {
      return isAdmin() || (isStaff() && hasPermission("payments"));
    }

    function canReadChat() {
      return isAdmin() || (isStaff() && hasPermission("chat"));
    }

    function ownsUser(userId) {
      return signedIn() && userId == request.auth.uid;
    }

    // Browser profile writes may update contact/presentation metadata only.
    // Role, permissions, status, and UID changes belong to the server-side
    // staff administration workflow (Admin SDK writes bypass these rules).
    function preservesUserAuthorization() {
      return request.resource.data.get("uid", "") == resource.data.get("uid", "")
        && request.resource.data.get("role", "") == resource.data.get("role", "")
        && request.resource.data.get("status", "active") == resource.data.get("status", "active")
        && request.resource.data.get("permissions", {}) == resource.data.get("permissions", {});
    }

    function isProfileMetadataUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "email",
        "phone",
        "profilePicture",
        "lastActiveAt"
      ])
        && preservesUserAuthorization();
    }

    function isClientProfileMetadataUpdate() {
      return resource.data.get("role", "") == "client"
        && request.resource.data.get("role", "") == "client"
        && isProfileMetadataUpdate();
    }

    // Customers may record only the visibility metadata for their own
    // status-aware chat suggestions. This is intentionally separate from the
    // ordinary profile allowlist so it cannot be used to alter contact data or
    // authorization fields.
    function isChatSuggestionStateUpdate(userId) {
      return ownsUser(userId)
        && resource.data.get("role", "") == "client"
        && request.resource.data.get("role", "") == "client"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["chatSuggestionState"])
        && request.resource.data.get("chatSuggestionState", {}).keys().hasOnly(["lastShownAt", "contextKey"])
        && request.resource.data.get("chatSuggestionState", {}).get("contextKey", "") is string
        && request.resource.data.get("chatSuggestionState", {}).get("contextKey", "").size() > 0
        && request.resource.data.get("chatSuggestionState", {}).get("contextKey", "").size() <= 500
        && request.resource.data.get("chatSuggestionState", {}).get("lastShownAt", null) is timestamp
        && preservesUserAuthorization();
    }

    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }

    function bookingOwner(bookingId) {
      return signedIn()
        && bookingId is string
        && bookingId != ""
        && exists(bookingPath(bookingId))
        && get(bookingPath(bookingId)).data.get("userId", "") == request.auth.uid;
    }

    function bookingBelongsTo(bookingId, userId) {
      return bookingId is string
        && userId is string
        && bookingId != ""
        && userId != ""
        && exists(bookingPath(bookingId))
        && get(bookingPath(bookingId)).data.get("userId", "") == userId;
    }

    function validNotification(data) {
      return data.keys().hasOnly([
          "type",
          "title",
          "message",
          "bookingId",
          "userId",
          "relatedUserId",
          "relatedUserName",
          "isRead",
          "moduleRead",
          "createdAt",
          "link"
        ])
        && data.get("type", "") is string
        && data.get("type", "").size() <= 64
        && data.get("title", "") is string
        && data.get("title", "").size() <= 160
        && data.get("message", "") is string
        && data.get("message", "").size() <= 1000
        && data.get("bookingId", "") is string
        && data.get("bookingId", "").size() <= 128
        && data.get("userId", "") is string
        && data.get("userId", "").size() <= 128
        && data.get("link", "") is string
        && data.get("link", "").size() <= 300
        && data.get("isRead", false) == false
        && data.get("moduleRead", false) == false;
    }

    function isBookingNotification(data) {
      return data.get("type", "") in [
        "booking_submitted",
        "cancellation_requested",
        "modification_requested"
      ];
    }

    function isPaymentNotification(data) {
      return data.get("type", "") in [
        "payment_submitted",
        "remaining_balance_submitted"
      ];
    }

    function canReadAdminNotification(data) {
      return isAdmin() || (
        isStaff() && (
          ((hasPermission("dashboard") || hasPermission("bookings"))
            && isBookingNotification(data))
          || (hasPermission("payments") && isPaymentNotification(data))
        )
      );
    }

    function isClientBookingUpdate() {
      return isClient()
        && resource.data.get("userId", "") == request.auth.uid
        && request.resource.data.get("userId", "") == resource.data.get("userId", "")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "bookingStatus",
          "paymentStatus",
          "lastActivityAt",
          "updatedAt",
          "previousStatus",
          "previousBookingStatus",
          "previousPaymentStatus",
          "cancellationRequested",
          "cancellationRequestedAt",
          "cancellationStatus",
          "cancellationStatusLabel",
          "cancellationReason",
          "cancellationUnderReview",
          "cancelRequestStatus",
          "cancelReason",
          "cancelRequestedAt",
          "adminCancelDecision",
          "adminCancelReason"
        ])
        && (
          request.resource.data.get("status", "") == resource.data.get("status", "")
          || request.resource.data.get("status", "") in [
            "pending",
            "verifying",
            "cancellation_requested",
            "cancelled"
          ]
        )
        && (
          request.resource.data.get("bookingStatus", "") == resource.data.get("bookingStatus", "")
          || request.resource.data.get("bookingStatus", "") in [
            "Pending Verification",
            "Cancellation Under Review",
            "Cancelled"
          ]
        )
        && (
          request.resource.data.get("paymentStatus", "") == resource.data.get("paymentStatus", "")
          || request.resource.data.get("paymentStatus", "") in [
            "for_review",
            "cash_pending",
            "slot_pending"
          ]
          || (
            request.resource.data.get("paymentStatus", "") == "cancelled"
            && resource.data.get("status", "") == "pending"
            && resource.data.get("paymentStatus", "") == "unpaid"
          )
        )
        // Cancellation requests and admin decisions are server-authoritative.
        // A client can request through /api/bookings/cancellation, but cannot
        // forge a pending, approved, or declined state with a direct write.
        && request.resource.data.get("cancellationRequested", false) == resource.data.get("cancellationRequested", false)
        && request.resource.data.get("cancellationRequestedAt", null) == resource.data.get("cancellationRequestedAt", null)
        && request.resource.data.get("cancellationStatus", "None") == resource.data.get("cancellationStatus", "None")
        && request.resource.data.get("cancellationStatusLabel", null) == resource.data.get("cancellationStatusLabel", null)
        && request.resource.data.get("cancellationReason", null) == resource.data.get("cancellationReason", null)
        && request.resource.data.get("cancellationUnderReview", false) == resource.data.get("cancellationUnderReview", false)
        && request.resource.data.get("cancelRequestStatus", null) == resource.data.get("cancelRequestStatus", null)
        && request.resource.data.get("cancelReason", null) == resource.data.get("cancelReason", null)
        && request.resource.data.get("cancelRequestedAt", null) == resource.data.get("cancelRequestedAt", null)
        && request.resource.data.get("adminCancelDecision", null) == resource.data.get("adminCancelDecision", null)
        && request.resource.data.get("adminCancelReason", null) == resource.data.get("adminCancelReason", null)
        && (
          request.resource.data.get("status", "") != "cancellation_requested"
          || resource.data.get("status", "") == "cancellation_requested"
        )
        && (
          request.resource.data.get("bookingStatus", "") != "Cancellation Under Review"
          || resource.data.get("bookingStatus", "") == "Cancellation Under Review"
        )
        && (
          request.resource.data.get("status", "") != "cancelled"
          || (
            resource.data.get("status", "") == "pending"
            && resource.data.get("paymentStatus", "") == "unpaid"
          )
        );
    }

    match /users/{userId} {
      allow read: if ownsUser(userId)
        || isAdmin()
        || (isStaff() && (
          hasPermission("users")
          || (hasPermission("chat") && resource.data.get("role", "") == "client")
        ));

      allow create: if ownsUser(userId)
        && request.resource.data.get("uid", "") == userId
        && request.resource.data.get("role", "") == "client"
        && request.resource.data.get("status", "") == "active"
        && !request.resource.data.keys().hasAny(["permissions"]);

      // Administrators manage roles, permissions, and account status through
      // /api/staff. Browser rules intentionally permit only ordinary profile
      // metadata, including an administrator's own profile/presence fields.
      // Staff users-management access is limited to client targets and the
      // same metadata allowlist; staff/admin authorization fields are frozen.
      allow update: if (isAdmin() && isProfileMetadataUpdate())
        || (isStaff() && hasPermission("users") && isClientProfileMetadataUpdate())
        || (isClient() && isChatSuggestionStateUpdate(userId))
        || (ownsUser(userId) && isProfileMetadataUpdate());

      allow delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if canReadBookings()
        || canReadReports()
        || (isClient() && resource.data.get("userId", "") == request.auth.uid);
      // All allocation/lifecycle writers go through the checked server APIs.
      allow create: if false;
      allow update: if (canWriteBookings() || isClientBookingUpdate())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "venueId", "officeId", "spaceId", "venue", "date", "startDate", "endDate",
          "startTime", "endTime", "time", "bookingCategory", "bookingType", "isOfficeRental",
          "officeRentalTerm", "rentalTerm", "contractTerm", "status", "bookingStatus",
          "isSlotSecured", "amountPaid", "totalPrice", "paymentStatus",
          "adminLogs", "paymentReceipts", "receipt", "receiptIssued",
          "receiptNumber", "receiptIssuedAt", "paymentReviewedAt",
          "paymentReviewedBy", "paymentVerifiedAt", "paymentVerifiedBy",
          "paymentVerifiedAmount", "verifiedByAdmin", "verifiedAt"
        ]);
      allow delete: if false;
    }

    match /officeRentals/{rentalId} {
      allow read: if canReadBookings()
        || (isClient() && resource.data.get("userId", "") == request.auth.uid);
      // Retained legacy rentals are read by availability. The unmounted browser
      // lease editor must not bypass the server's scheduling locks.
      allow create, update: if false;
      allow delete: if false;
    }

    match /maintenanceRecords/{recordId} {
      allow read: if signedIn();
      // Availability validation and atomic batches are enforced by /api/maintenance.
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if canReadPayments()
        || canReadReports()
        || (
          isClient()
          && resource.data.get("customerId", "") == request.auth.uid
        );
      // Payment submissions, verification decisions, and their ledger fields
      // are written by authenticated server transactions only.
      allow create, update: if false;
      allow delete: if false;
    }

    match /receipts/{receiptId} {
      allow read: if canReadPayments()
        || canReadBookings()
        || (isClient() && bookingOwner(resource.data.get("bookingId", "")));
      // Receipts contain verified amounts, payment joins, review snapshots,
      // and administrator audit metadata. They are server-issued only.
      allow create, update: if false;
      allow delete: if false;
    }

    match /paymentProofs/{proofId} {
      allow read: if canReadPayments()
        || (isClient() && bookingOwner(resource.data.get("bookingId", "")));
      allow create: if canWritePayments();
      allow update: if canWritePayments();
      allow delete: if false;
    }

    match /chatMessages/{messageId} {
      allow read: if canReadChat()
        || (isClient() && resource.data.get("clientId", "") == request.auth.uid);

      allow create: if (
        isClient()
        && request.resource.data.keys().hasOnly([
          "text",
          "content",
          "sender",
          "senderId",
          "senderName",
          "senderAvatar",
          "clientId",
          "clientName",
          "clientProfilePicture",
          "targetId",
          "recipientId",
          "timestamp",
          "time",
          "imageUrl",
          "isRead",
          "isReadByClient",
          "read",
          "isBot"
        ])
        && request.resource.data.get("clientId", "") == request.auth.uid
        && request.resource.data.get("text", "") is string
        && request.resource.data.get("text", "").size() <= 5000
        && request.resource.data.get("isBot", false) == false
        && (
          request.resource.data.get("sender", "") in ["client", "user"]
          && request.resource.data.get("senderId", "") == request.auth.uid
        )
      ) || (
        canReadChat()
        && request.resource.data.get("sender", "") == "admin"
        && request.resource.data.get("senderId", "") == "admin"
        && request.resource.data.get("clientId", "") != ""
        && exists(profilePath(request.resource.data.get("clientId", "")))
        && get(profilePath(request.resource.data.get("clientId", ""))).data.get("role", "") == "client"
        && request.resource.data.get("text", "") is string
        && request.resource.data.get("text", "").size() <= 5000
      );

      allow update: if (
        isClient()
        && resource.data.get("clientId", "") == request.auth.uid
        && resource.data.get("sender", "") == "admin"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isReadByClient", "read"])
        && request.resource.data.get("isReadByClient", false) == true
      ) || (
        canReadChat()
        && resource.data.get("sender", "") in ["client", "user"]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "read"])
        && request.resource.data.get("isRead", false) == true
      );

      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if isClient()
        && bookingOwner(request.resource.data.get("bookingId", ""))
        && get(bookingPath(request.resource.data.get("bookingId", ""))).data.get("status", "") in ["completed", "complete"]
        && request.resource.data.get("rating", 0) is int
        && request.resource.data.get("rating", 0) >= 1
        && request.resource.data.get("rating", 0) <= 5
        && request.resource.data.get("comment", "") is string
        && request.resource.data.get("comment", "").size() <= 4000;
      allow update, delete: if false;
    }

    match /cms/{document} {
      allow read: if document == "data";
      allow create, delete: if isAdmin() || (isStaff() && hasPermission("cms"));
      allow update: if isAdmin()
        || (isStaff() && hasPermission("cms"))
        || (
          isClient()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["bookingCounter"])
          && request.resource.data.get("bookingCounter", 0) == resource.data.get("bookingCounter", 0) + 1
        );
    }

    // Automated-answer content is split from the public CMS document. The
    // protected config contains unpublished answers; customers can only read
    // a version marker. The filtered question projection is returned by the
    // authenticated server route, never through a browser client.
    match /chatSuggestionQuestions/{document} {
      allow read: if (
        document == "publishedVersion"
        && (isClient() || hasPermission("cms"))
      ) || (
        document == "config"
        && hasPermission("cms")
      ) || (
        document == "published"
        && hasPermission("cms")
      );
      allow create, update, delete: if false;
    }

    match /contracts/{contractId} {
      allow read: if canReadBookings()
        || canReadPayments()
        || (isClient() && bookingOwner(resource.data.get("bookingId", "")));
      allow create, update, delete: if isAdmin() || (isStaff() && hasPermission("cms"));
    }

    match /notifications/{notificationId} {
      allow read: if (
        isClient() && resource.data.get("userId", "") == request.auth.uid
      ) || (
        canReadAdminNotification(resource.data)
        && resource.data.get("userId", "") == "admin"
      );

      allow create: if (
        isClient()
        && validNotification(request.resource.data)
        && request.resource.data.get("type", "") in ["cancellation_requested", "modification_requested"]
        && request.resource.data.get("userId", "") == "admin"
        && request.resource.data.get("relatedUserId", "") == request.auth.uid
        && bookingOwner(request.resource.data.get("bookingId", ""))
      ) || (
        (isAdmin() || (isStaff() && (hasPermission("bookings") || hasPermission("payments"))))
        && validNotification(request.resource.data)
        && (
          request.resource.data.get("userId", "") == "admin"
          || bookingBelongsTo(
            request.resource.data.get("bookingId", ""),
            request.resource.data.get("userId", "")
          )
        )
      );

      allow update: if (
        isClient()
        && resource.data.get("userId", "") == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "moduleRead"])
        && request.resource.data.get("isRead", false) == true
        && request.resource.data.get("moduleRead", false) == true
      ) || (
        canReadAdminNotification(resource.data)
        && resource.data.get("userId", "") == "admin"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "moduleRead"])
        && request.resource.data.get("isRead", false) == true
        && request.resource.data.get("moduleRead", false) == true
      );

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
