# Public Firebase web configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only Firebase Admin credentials
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Server-only Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional sanitized performance tracing (1 enables logs, 0 disables it)
NEXT_PUBLIC_PERF_TRACE=0

# Server-only Gmail SMTP and transactional email controls. Sending is disabled
# unless explicitly set to true; never use NEXT_PUBLIC_ names for these values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3000
EMAIL_SENDING_ENABLED=false
EMAIL_TEST_RECIPIENT_ALLOWLIST=
EMAIL_MAX_ATTEMPTS=5
# OTP delivery is independent of transactional email and remains disabled by default.
EMAIL_OTP_SENDING_ENABLED=false
# Required true only for an owner-authorized staging OTP test.
EMAIL_OTP_STAGING_APPROVED=false
EMAIL_OTP_SECRET=
EMAIL_OTP_EXPIRY_SECONDS=600
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
# Required in addition to EMAIL_OTP_SENDING_ENABLED=true for production delivery.
EMAIL_OTP_PRODUCTION_APPROVED=false
# Public compatibility-only Firebase link fallback; OTP remains the primary flow.
NEXT_PUBLIC_EMAIL_VERIFICATION_LINK_FALLBACK_ENABLED=false
EMAIL_VERIFICATION_ENFORCEMENT_ENABLED=false
# Required when enforcement is enabled; use an ISO timestamp at activation.
EMAIL_VERIFICATION_ENFORCEMENT_START_AT=
# Optional protected worker secret; keep it server-only.
CRON_SECRET=
